            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created o 409 Conflict', () => {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Response tiene id', () => pm.expect(json.id).to.exist);",
                  "  pm.test('Cédula coincide', () => pm.expect(json.cedula).to.eql(pm.collectionVariables.get('cedula')));",
                  "  pm.collectionVariables.set('estudianteId', json.id);",
                  "  console.log('✅ Estudiante creado con ID:', json.id);",
                  "} else if (pm.response.code === 409) {",
                  "  console.log('⚠️ Estudiante ya existe (cédula duplicada)');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /estudiantes/{id} (Actualizar)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
