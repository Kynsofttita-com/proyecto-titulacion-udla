.pnpm-debug.log*

# Coverage / tests
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/
playwright-report/
cypress/screenshots/
cypress/videos/
cypress/downloads/

# Linting/formatting cache
.eslintcache
.stylelintcache
.prettiercache

# IMPORTANTE: lock files SÍ se commitean (reproducibilidad)
# package-lock.json, yarn.lock, pnpm-lock.yaml NO se ignoran

# -------- Secretos y credenciales --------
.env
.env.local
.env.*.local
.env.production
.env.staging
# IMPORTANTE: .env.example SÍ se commitea (template)
!.env.example
*.key
*.pem
*.pfx
*.p12
*.crt
secrets/
credentials.json
application-prod.yml
application-prod.yaml
application-secrets.yml

# Cloud / orquestadores credentials
.aws/
.kube/
.gcloud/
.kubeconfig
kubeconfig

# -------- Bases de datos --------
*.db
*.sqlite
*.sqlite3
*.mdb
*.accdb
*.dump
*.bak
postgres_data/
postgres-data/
mysql_data/
backup/

# -------- Docker --------
# IMPORTANTE: .dockerignore SI se commitea (necesario para builds reproducibles)
docker-compose.override.yml
docker-compose.local.yml
Dockerfile.local

# -------- Logs y runtime --------
logs/
log/
*.log
*.pid
*.seed
*.pid.lock

# -------- SonarQube / Code quality --------
.sonarqube/
.scannerwork/
.sonar/

# -------- Coverage Java (JaCoCo) --------
jacoco.exec
jacoco-it.exec
jacoco-ut.exec

# -------- Archivos temporales --------
*.tmp
*.temp
*.bak
*~

# -------- Compilados nativos --------
*.so
*.dylib
# Nota: *.dll, *.exe NO se ignoran globalmente (puede haber binarios necesarios en infra)

# -------- GitHub Actions secrets --------
.github/workflows/secrets.yml

# -------- Documentación generada --------
docs/_build/
docs/.vuepress/dist/

# -------- Excel temporales --------
~$*.xlsx
~$*.docx

# -------- Otros --------
.turbo/
.nx/
*.local

# Compiled JARs (pre-built for Docker, must be built locally via ./scripts/build-backend.sh)
infrastructure/docker/jars-dist/*.jar
backend/jars-dist/*.jar
