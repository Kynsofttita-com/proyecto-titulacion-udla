# Multi-stage Dockerfile genérico para Spring Boot microservicios
# Los JARs se compilan localmente (mvn clean package -DskipTests)
# Uso: docker build --build-arg SERVICE_MODULE=ms-auth --build-arg SERVICE_PORT=8081 -f Dockerfile.spring .

ARG SERVICE_MODULE=eureka-server
ARG SERVICE_PORT=8761
ARG JAR_NAME=eureka-server

# Stage: Runtime (JARs pre-compilados)
FROM eclipse-temurin:21-jre-alpine

ARG SERVICE_MODULE
ARG SERVICE_PORT
ARG JAR_NAME

# Instalar dependencias
RUN apk add --no-cache curl tzdata && \
    cp /usr/share/zoneinfo/America/Guayaquil /etc/localtime && \
    echo "America/Guayaquil" > /etc/timezone

# Crear usuario spring (non-root)
RUN addgroup -S spring && \
    adduser -S -G spring -u 1000 spring

# Preparar directorio de aplicación
WORKDIR /app
RUN mkdir -p /app/storage && chown -R spring:spring /app

# Copiar JAR específico desde jars-dist/
COPY --chown=spring:spring jars-dist/ /tmp/jars/
RUN cp /tmp/jars/${JAR_NAME}.jar /app/app.jar && rm -rf /tmp/jars

# Variables de entorno
ENV SERVICE_PORT=${SERVICE_PORT} \
    JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom -Duser.timezone=America/Guayaquil"

# Cambiar a usuario spring
USER spring:spring
EXPOSE ${SERVICE_PORT}

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=10 \
    CMD curl -fsS "http://localhost:${SERVICE_PORT}/actuator/health" | grep -q '"status":"UP"' || exit 1

# Ejecutar aplicación
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
