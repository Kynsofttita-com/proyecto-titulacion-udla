    {
      "name": "4 Password Recovery (gatilla emails Mailtrap)",
      "item": [
        {
          "name": "Forgot password — email existente (202)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('Mensaje anti-enumeration', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.include('Si el email existe');",
                  "});",
                  "console.log('📬 Revisa Mailtrap → debería llegar email \"Recuperar contrasenia\"');"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password — email inexistente (202 también)",
          "description": "Anti-enumeration: la API devuelve 202 exista o no el email para evitar revelar qué usuarios están registrados.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"fantasma@nope.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 202 (anti-enumeration)', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password — email mal formado (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no-es-email\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset password (manual: pega el token del email)",
          "description": "1. Corre 'Forgot password — email existente'.\n2. Abre Mailtrap, copia el token UUID del link de recuperación.\n3. Pégalo en la variable de colección 'resetToken'.\n4. Ejecuta este request.\n5. Verifica el email de confirmación en Mailtrap.\n\nNOTA: cambia la password del admin. Para volver a 'Admin123!' después: corre forgot/reset otra vez o reseed la DB.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"NuevaPass456!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 (No Content)', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset password — token invalido (400/401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"00000000-0000-0000-0000-000000000000\",\n  \"newPassword\": \"NuevaPass456!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 4xx', () => pm.expect(pm.response.code).to.be.oneOf([400, 401, 404]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset password — newPassword muy corta (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"00000000-0000-0000-0000-000000000000\",\n  \"newPassword\": \"abc\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 (validacion size)', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
