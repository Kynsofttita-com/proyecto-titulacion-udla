# =============================================================================
# Variables de entorno - Sistema de Control Administrativo Escuelas de Conducción
# =============================================================================
# Copia este archivo a `.env` y ajusta los valores según tu ambiente.
# IMPORTANTE: NO commitear `.env` al repositorio (está en .gitignore).
# Las credenciales aquí son SOLO para desarrollo local — cambiar en producción.
# =============================================================================

# -----------------------------------------------------------------------------
# Spring profile activo
# Valores posibles: local, dev, staging, prod
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# -----------------------------------------------------------------------------
# PostgreSQL - Base de datos
# -----------------------------------------------------------------------------
# Para desarrollo SIN Docker: POSTGRES_HOST=localhost
# Para desarrollo CON Docker Compose (los MS dentro del compose): POSTGRES_HOST=postgres
# En producción: hostname o IP del servidor de BD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=escuela_db
POSTGRES_USER=escuela_user
POSTGRES_PASSWORD=changeme

# -----------------------------------------------------------------------------
# RabbitMQ - Mensajería asíncrona
# -----------------------------------------------------------------------------
# Para desarrollo SIN Docker: RABBITMQ_HOST=localhost
# Para desarrollo CON Docker Compose (los MS dentro del compose): RABBITMQ_HOST=rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# -----------------------------------------------------------------------------
# JWT (JSON Web Tokens) - Autenticación
# -----------------------------------------------------------------------------
# IMPORTANTE: en producción usar una clave de 512 bits (64 caracteres mínimo)
# Generar con: openssl rand -base64 64
JWT_SECRET=changeme-this-must-be-512-bits-or-64-characters-long-for-security-purposes
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=escuela-conducir

# -----------------------------------------------------------------------------
# Email (Mailtrap para desarrollo, Gmail SMTP para producción)
# -----------------------------------------------------------------------------
# Mailtrap dev: https://mailtrap.io (free tier)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-user
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM=noreply@escuela.local
MAIL_FROM_NAME=Escuela de Conducción

# Producción (Gmail SMTP):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# -----------------------------------------------------------------------------
# MinIO - Object Storage
# -----------------------------------------------------------------------------
# Para desarrollo SIN Docker: MINIO_HOST=localhost
# Para desarrollo CON Docker Compose: MINIO_HOST=minio
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_DOCUMENTOS=documentos
MINIO_BUCKET_VEHICULOS=vehiculos
MINIO_BUCKET_AVATARES=avatares
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# Eureka - Service Discovery
# -----------------------------------------------------------------------------
# Para desarrollo SIN Docker: EUREKA_URL=http://localhost:8761/eureka
# Para desarrollo CON Docker Compose: EUREKA_URL=http://eureka-server:8761/eureka
EUREKA_URL=http://localhost:8761/eureka

# -----------------------------------------------------------------------------
# Puertos de los microservicios (para referencia, definidos en cada application.yml)
# -----------------------------------------------------------------------------
# API Gateway:        8080
# MS-Auth:            8081
# MS-Estudiantes:     8082
# MS-Instructores:    8083
# MS-Vehículos:       8084
# MS-Asignaciones:    8085
# MS-Cobros:          8086
# MS-Reportes:        8087
# MS-Notificaciones:  8088
# Eureka Server:      8761
# Frontend (Vue):     5173

# -----------------------------------------------------------------------------
# Adminer (UI para inspección de BD - solo dev)
# -----------------------------------------------------------------------------
ADMINER_PORT=8888

# -----------------------------------------------------------------------------
# Frontend (Vue.js) - URL del backend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_API_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=WARN

# -----------------------------------------------------------------------------
# Rate limiting (API Gateway)
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# -----------------------------------------------------------------------------
# CORS (orígenes permitidos, separados por coma)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
