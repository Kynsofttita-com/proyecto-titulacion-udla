.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Builds
dist/
dist-ssr/
build/
.vite/
.nuxt/
.output/
.cache/

# Logs npm/yarn/pnpm
npm-debug.log*
yarn-error.log
