// =============================================================================
// Diagrama ER - Sistema de Control Administrativo y Financiero
// para Escuelas de Conducción
//
// Pegar este archivo en: https://dbdiagram.io
// (botón "Import" -> "From DBML" o directamente "New" y pegar)
//
// Exportar a PNG/SVG/PDF desde el menú "Export" en dbdiagram.io
//
// Última actualización: 2026-05-26 (refleja schema real al cierre de Sprint 10)
// =============================================================================

Project escuela_db {
  database_type: 'PostgreSQL'
  Note: '''
  Sistema de Escuelas de Conducción - Ecuador
  1 base de datos, 9 schemas, 41 tablas
  Sprint 10 - estado real al 2026-05-26
  '''
}

// =============================================================================
// AUTH_SCHEMA (MS-Auth)
// =============================================================================

Table usuarios {
  id bigint [pk, increment]
  email varchar(255) [unique, not null]
  password varchar(60) [not null, note: 'BCrypt cost 10']
  nombre varchar(100) [not null]
  apellido varchar(100) [not null]
  telefono varchar(10)
  activo boolean [not null, default: true]
  locked boolean [not null, default: false]
  failed_attempts smallint [not null, default: 0]
  last_login timestamp
  lock_until timestamp
  password_change_required boolean [not null, default: false, note: 'V3']
  cedula varchar(10) [note: 'V5']
  fecha_nacimiento date [note: 'V5']
  genero varchar(1) [note: 'V5']
  direccion varchar(255) [note: 'V5']
  ciudad varchar(100) [note: 'V5']
  provincia varchar(100) [note: 'V5']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  created_by varchar(50)
  updated_by varchar(50)
  deleted_at timestamp

  indexes {
    email
    (activo, locked)
  }
}

Table roles {
  id bigint [pk, increment]
  nombre varchar(50) [unique, not null, note: 'ADMIN/STAFF/INSTRUCTOR/ESTUDIANTE']
  descripcion varchar(255)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp
}

Table permisos {
  id bigint [pk, increment]
  codigo varchar(100) [unique, not null]
  recurso varchar(50) [not null]
  accion varchar(50) [not null]
  descripcion varchar(255)
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table usuario_rol {
  usuario_id bigint [ref: > usuarios.id]
  rol_id bigint [ref: > roles.id]
  created_at timestamp [not null, default: `now()`]
  created_by varchar(50)

  indexes {
    (usuario_id, rol_id) [pk]
  }
}

Table rol_permiso {
  rol_id bigint [ref: > roles.id]
  permiso_id bigint [ref: > permisos.id]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (rol_id, permiso_id) [pk]
  }
}

Table password_reset_token {
  id bigint [pk, increment]
  usuario_id bigint [not null, ref: > usuarios.id]
  token uuid [unique, not null]
  expira_en timestamp [not null]
  usado boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
}

Table refresh_tokens {
  id bigint [pk, increment]
  usuario_id bigint [not null, ref: > usuarios.id]
  jti uuid [unique, not null]
  expira_en timestamp [not null]
  revocado boolean [not null, default: false]
  revocado_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (usuario_id, revocado)
    expira_en
  }
}

Table configuracion_escuela {
  id bigint [pk, increment]
  nombre varchar(255) [not null]
  ruc varchar(13) [unique, not null]
  direccion text
  telefono varchar(20)
  email varchar(255)
  logo_url varchar(500)
  color_primario varchar(7)
  color_secundario varchar(7)
  duracion_clase_default_min smallint [not null, default: 60]
  horario_apertura time
  horario_cierre time
  horas_recordatorio_clase smallint [not null, default: 24]
  dias_alerta_soat smallint [not null, default: 30]
  max_intentos_fallidos smallint [not null, default: 3, note: 'V4']
  duracion_bloqueo_minutos smallint [not null, default: 15, note: 'V4']
  expiracion_token_reset_minutos smallint [not null, default: 60, note: 'V4']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
}

Table tipos_curso {
  id bigint [pk, increment]
  nombre varchar(100) [unique, not null]
  descripcion text
  duracion_total_horas smallint [not null]
  precio_base numeric(10,2) [not null]
  categoria_licencia_id bigint [ref: > categorias_licencia.id]
  activo boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table conceptos_facturacion {
  id bigint [pk, increment]
  nombre varchar(100) [unique, not null]
  monto_base numeric(10,2) [not null]
  descripcion text
  activo boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table categorias_licencia {
  id bigint [pk, increment]
  codigo varchar(20) [unique, not null, note: 'A/A1/B/C/C1/D/D1/E/F/PROF']
  descripcion varchar(255) [not null]
  activa boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table plantillas_email {
  id bigint [pk, increment]
  codigo varchar(100) [unique, not null]
  asunto varchar(255) [not null]
  cuerpo_html text [not null]
  variables jsonb
  activa boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

// =============================================================================
// ESTUDIANTES_SCHEMA (MS-Estudiantes)
// =============================================================================

Table estudiantes {
  id bigint [pk, increment]
  cedula varchar(10) [unique, not null]
  nombre varchar(100) [not null]
  apellido varchar(100) [not null]
  email varchar(255) [unique, not null]
  telefono varchar(10) [not null]
  direccion text
  fecha_nacimiento date [not null]
  genero varchar(1) [note: 'M/F/O']
  estado varchar(20) [not null, note: 'PRE_MATRICULADO/MATRICULADO/CURSANDO/COMPLETADO/RETIRADO']
  situacion_pago varchar(30) [not null, default: 'PENDIENTE_FACTURACION', note: 'V4: PENDIENTE_FACTURACION/PENDIENTE_PAGO/PAGO_PARCIAL/PAGADO_TOTAL']
  minutos_completados integer [not null, default: 0, note: 'V5: clases completadas en minutos']
  fecha_matricula date
  tipo_curso_id bigint [note: 'ref auth_schema.tipos_curso (cross-schema, sin FK)']
  categoria_licencia_id bigint [note: 'ref auth_schema.categorias_licencia']
  usuario_id bigint [note: 'ref auth_schema.usuarios (opcional)']
  observaciones text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  indexes {
    cedula
    email
    estado
    situacion_pago
    (apellido, nombre)
  }
}

Table documentos {
  id bigint [pk, increment]
  estudiante_id bigint [not null, ref: > estudiantes.id]
  tipo varchar(30) [not null, note: 'CEDULA_FRENTE/CEDULA_REVERSO/FOTO/EXAMEN_MEDICO/OTRO']
  url_archivo varchar(500) [not null]
  fecha_subida timestamp [not null, default: `now()`]
  mime_type varchar(100)
  tamano_bytes bigint
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table contactos_emergencia {
  id bigint [pk, increment]
  estudiante_id bigint [not null, ref: > estudiantes.id]
  nombre varchar(200) [not null]
  telefono varchar(15) [not null]
  parentesco varchar(50)
  es_principal boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table progreso_academico {
  id bigint [pk, increment]
  estudiante_id bigint [unique, not null, ref: - estudiantes.id]
  clases_planeadas smallint [not null, default: 0]
  clases_completadas smallint [not null, default: 0]
  clases_pendientes smallint [not null, default: 0]
  clases_canceladas smallint [not null, default: 0]
  calificacion_promedio numeric(4,2) [note: '0-100']
  aprobado boolean
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
}

Table asistencia {
  id bigint [pk, increment]
  estudiante_id bigint [not null, ref: > estudiantes.id]
  asignacion_id bigint [not null, note: 'ref asignaciones_schema.asignaciones']
  fecha_clase date [not null]
  asistio boolean [not null]
  justificacion text
  observaciones text
  created_at timestamp [not null, default: `now()`]

  indexes {
    (estudiante_id, fecha_clase)
    (estudiante_id, asignacion_id) [unique]
  }
}

// =============================================================================
// INSTRUCTORES_SCHEMA (MS-Instructores)
// =============================================================================

Table instructores {
  id bigint [pk, increment]
  cedula varchar(10) [unique, not null]
  nombre varchar(100) [not null]
  apellido varchar(100) [not null]
  email varchar(255) [unique, not null]
  telefono varchar(10) [not null]
  direccion text
  fecha_nacimiento date
  licencia_numero varchar(50) [unique, not null]
  licencia_categoria varchar(20) [not null]
  licencia_emision date [not null]
  licencia_caducidad date [not null]
  estado varchar(20) [not null, note: 'ACTIVO/INACTIVO/SUSPENDIDO']
  fecha_contratacion date
  salario_mensual numeric(10,2)
  tipo_contrato varchar(20) [not null, default: 'TIEMPO_COMPLETO', note: 'V2: TIEMPO_COMPLETO/MEDIO_TIEMPO/POR_HORAS']
  horas_contrato_semanales smallint [not null, default: 40, note: 'V2: 1-60']
  tarifa_hora numeric(8,2) [note: 'V2: obligatorio si POR_HORAS']
  usuario_id bigint [note: 'ref auth_schema.usuarios']
  observaciones text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  indexes {
    cedula
    licencia_numero
    estado
    tipo_contrato
  }
}

Table certificaciones {
  id bigint [pk, increment]
  instructor_id bigint [not null, ref: > instructores.id]
  tipo varchar(100) [not null]
  fecha_obtencion date [not null]
  vigencia_hasta date
  entidad_emisora varchar(255)
  archivo_url varchar(500)
  observaciones text
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table disponibilidad {
  id bigint [pk, increment]
  instructor_id bigint [not null, ref: > instructores.id]
  dia_semana smallint [not null, note: '1=Lun, 7=Dom']
  hora_inicio time [not null]
  hora_fin time [not null]
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  indexes {
    (instructor_id, dia_semana, hora_inicio) [unique]
  }
}

Table horarios_trabajo {
  id bigint [pk, increment]
  instructor_id bigint [not null, ref: > instructores.id]
  fecha date [not null]
  hora_inicio time
  hora_fin time
  tipo varchar(20) [not null, note: 'EXTRA/AUSENCIA']
  motivo text
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

// =============================================================================
// VEHICULOS_SCHEMA (MS-Vehiculos)
// =============================================================================

Table tipos_combustible {
  id bigint [pk, increment]
  codigo varchar(20) [unique, not null, note: 'V2: EXTRA/ECOPAIS/SUPER/DIESEL/ELECTRICO']
  nombre varchar(100) [not null]
  unidad varchar(20) [not null, default: 'GALON', note: 'GALON/LITRO/KWH']
  precio_actual numeric(8,4) [not null]
  activo boolean [not null, default: true]
  observaciones text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
}

Table vehiculos {
  id bigint [pk, increment]
  placa varchar(8) [unique, not null]
  marca varchar(50) [not null]
  modelo varchar(50) [not null]
  anio smallint [not null]
  vin varchar(17) [unique]
  color varchar(30)
  kilometraje integer [not null, default: 0]
  estado varchar(20) [not null, note: 'ACTIVO/MANTENIMIENTO/FUERA_SERVICIO']
  soat_vencimiento date
  revision_vencimiento date
  fecha_compra date
  valor_compra numeric(10,2)
  categoria_licencia_id bigint [note: 'ref auth_schema.categorias_licencia']
  numero_motor varchar(50) [note: 'V2']
  numero_chasis varchar(50) [note: 'V2']
  capacidad_pasajeros smallint [note: 'V2: 1-100']
  tipo_combustible_id bigint [ref: > tipos_combustible.id, note: 'V2']
  observaciones text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  indexes {
    placa
    estado
    soat_vencimiento
  }
}

Table mantenimientos {
  id bigint [pk, increment]
  vehiculo_id bigint [not null, ref: > vehiculos.id]
  tipo varchar(20) [not null, note: 'PREVENTIVO/CORRECTIVO']
  fecha date [not null]
  costo numeric(10,2) [not null]
  descripcion text [not null]
  taller varchar(255)
  kilometraje_servicio integer
  proxima_fecha date
  proximo_kilometraje integer
  archivo_factura_url varchar(500)
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table registros_combustible {
  id bigint [pk, increment]
  vehiculo_id bigint [not null, ref: > vehiculos.id]
  fecha timestamp [not null]
  litros numeric(8,2) [not null]
  costo_total numeric(10,2) [not null]
  costo_por_litro numeric(8,4) [note: 'GENERATED: costo_total/litros']
  kilometraje_actual integer [not null]
  estacion varchar(255)
  created_at timestamp [not null, default: `now()`]
}

Table inspecciones {
  id bigint [pk, increment]
  vehiculo_id bigint [not null, ref: > vehiculos.id]
  tipo varchar(20) [not null, note: 'TECNICA/SOAT/INTERNA']
  fecha date [not null]
  resultado varchar(20) [not null, note: 'APROBADA/REPROBADA/CONDICIONADA']
  archivo_url varchar(500)
  observaciones text
  proxima_inspeccion date
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table documentos_vehiculo {
  id bigint [pk, increment]
  vehiculo_id bigint [not null, ref: > vehiculos.id]
  tipo varchar(50) [not null]
  numero varchar(100)
  url_archivo varchar(500) [not null]
  fecha_emision date
  fecha_vencimiento date
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

// =============================================================================
// ASIGNACIONES_SCHEMA (MS-Asignaciones)
// =============================================================================

Table asignaciones {
  id bigint [pk, increment]
  instructor_id bigint [not null, note: 'ref instructores_schema.instructores']
  estudiante_id bigint [not null, note: 'ref estudiantes_schema.estudiantes']
  vehiculo_id bigint [not null, note: 'ref vehiculos_schema.vehiculos']
  fecha_hora timestamp [not null]
  duracion_minutos smallint [not null, default: 60]
  estado varchar(20) [not null, note: 'PROGRAMADA/CONFIRMADA/EN_CURSO/COMPLETADA/CANCELADA/NO_ASISTIO']
  tipo_clase varchar(20) [not null, note: 'TEORICA/PRACTICA/EXAMEN']
  ubicacion varchar(255)
  observaciones text
  motivo_cancelacion text
  km_inicial integer [note: 'V2: kilometraje al iniciar clase']
  km_final integer [note: 'V2: kilometraje al finalizar']
  hora_inicio_real timestamp [note: 'V2']
  hora_fin_real timestamp [note: 'V2']
  observaciones_recorrido text [note: 'V2']
  version bigint [not null, default: 0, note: 'optimistic locking']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  indexes {
    (instructor_id, fecha_hora)
    (estudiante_id, fecha_hora)
    (vehiculo_id, fecha_hora)
    (estado, fecha_hora)
  }
}

Table cambios_asignacion {
  id bigint [pk, increment]
  asignacion_id bigint [not null, ref: > asignaciones.id]
  fecha_cambio timestamp [not null, default: `now()`]
  motivo text [not null]
  fecha_anterior timestamp
  fecha_nueva timestamp
  instructor_anterior bigint
  instructor_nuevo bigint
  vehiculo_anterior bigint
  vehiculo_nuevo bigint
  usuario_id bigint [not null]
  created_at timestamp [not null, default: `now()`]
}

Table historial_estados {
  id bigint [pk, increment]
  asignacion_id bigint [not null, ref: > asignaciones.id]
  estado_anterior varchar(20)
  estado_nuevo varchar(20) [not null]
  fecha_cambio timestamp [not null, default: `now()`]
  usuario_id bigint
  observaciones text
  created_at timestamp [not null, default: `now()`]
}

// =============================================================================
// COBROS_SCHEMA (MS-Cobros)
// =============================================================================

Table facturas {
  id bigint [pk, increment]
  numero_factura varchar(20) [unique, not null, note: 'YYYYMM-####']
  estudiante_id bigint [not null, note: 'ref estudiantes_schema.estudiantes']
  concepto_facturacion_id bigint [not null, note: 'ref auth_schema.conceptos_facturacion']
  descripcion varchar(255)
  monto_original numeric(10,2) [not null]
  monto_pagado numeric(10,2) [not null, default: 0]
  saldo numeric(10,2) [note: 'GENERATED: monto_original - monto_pagado']
  estado varchar(20) [not null, note: 'PENDIENTE/PARCIAL/PAGADA/PAGADO/VENCIDA/ANULADA']
  fecha_emision date [not null, default: `CURRENT_DATE`]
  fecha_vencimiento date [not null]
  motivo_anulacion text
  tipo_pago varchar(20) [not null, default: 'CONTADO', note: 'V2: CONTADO/CREDITO']
  numero_cuotas int [not null, default: 1, note: 'V2: 1-24']
  cuotas_pagadas int [not null, default: 0, note: 'V2']
  frecuencia_cuota varchar(20) [note: 'V2: MENSUAL/QUINCENAL/SEMANAL']
  fecha_primera_cuota date [note: 'V2']
  valor_cuota numeric(10,2) [note: 'V2: monto_original/numero_cuotas']
  version bigint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  indexes {
    numero_factura
    estudiante_id
    (estado, fecha_vencimiento)
  }
}

Table factura_cuotas {
  id bigint [pk, increment]
  factura_id bigint [not null, ref: > facturas.id]
  numero_cuota int [not null]
  monto numeric(10,2) [not null]
  monto_pagado numeric(10,2) [not null, default: 0]
  saldo numeric(10,2) [note: 'GENERATED: monto - monto_pagado']
  fecha_vencimiento date [not null]
  fecha_pago_completa timestamp
  estado varchar(20) [not null, default: 'PENDIENTE', note: 'PENDIENTE/PARCIAL/PAGADA/VENCIDA']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    factura_id
    (factura_id, numero_cuota) [unique]
    (estado, fecha_vencimiento)
  }
}

Table pagos {
  id bigint [pk, increment]
  factura_id bigint [not null, ref: > facturas.id]
  monto numeric(10,2) [not null]
  fecha_pago timestamp [not null, default: `now()`]
  metodo_pago varchar(20) [not null, note: 'EFECTIVO/TARJETA/TRANSFERENCIA/CHEQUE']
  referencia_transaccion varchar(100)
  observaciones text
  usuario_registro_id bigint [not null, note: 'ref auth_schema.usuarios']
  numero_cuota int [note: 'V2']
  factura_cuota_id bigint [ref: > factura_cuotas.id, note: 'V2']
  created_at timestamp [not null, default: `now()`]
  created_by varchar(50)

  indexes {
    factura_id
    fecha_pago
    factura_cuota_id
  }
}

Table reconciliacion {
  id bigint [pk, increment]
  fecha date [unique, not null]
  total_efectivo numeric(10,2) [not null, default: 0]
  total_tarjeta numeric(10,2) [not null, default: 0]
  total_transferencia numeric(10,2) [not null, default: 0]
  total_cheque numeric(10,2) [not null, default: 0]
  total_dia numeric(10,2) [note: 'GENERATED']
  cantidad_pagos integer [not null, default: 0]
  usuario_conciliador_id bigint
  observaciones text
  created_at timestamp [not null, default: `now()`]
}

// =============================================================================
// NOTIFICACIONES_SCHEMA (MS-Notificaciones)
// =============================================================================

Table notificaciones {
  id bigint [pk, increment]
  usuario_id bigint [not null, note: 'ref auth_schema.usuarios']
  tipo varchar(50) [not null]
  titulo varchar(255) [not null]
  mensaje text [not null]
  leida boolean [not null, default: false]
  fecha_creacion timestamp [not null, default: `now()`]
  fecha_lectura timestamp
  datos_extra jsonb [note: 'deep-linking ej {"asignacion_id":42}']
  prioridad varchar(10) [not null, default: 'NORMAL', note: 'BAJA/NORMAL/ALTA']
  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  indexes {
    (usuario_id, leida)
    fecha_creacion
  }
}

Table log_envios_email {
  id bigint [pk, increment]
  destinatario varchar(255) [not null]
  asunto varchar(255) [not null]
  plantilla_codigo varchar(100)
  estado varchar(20) [not null, note: 'PENDIENTE/ENVIADO/FALLIDO']
  enviado_en timestamp
  intentos smallint [not null, default: 0]
  error_mensaje text
  usuario_id bigint
  created_at timestamp [not null, default: `now()`]
}

Table preferencias_notificacion {
  id bigint [pk, increment]
  usuario_id bigint [unique, not null, note: 'ref auth_schema.usuarios']
  recibir_email boolean [not null, default: true]
  recibir_in_app boolean [not null, default: true]
  recibir_recordatorios boolean [not null, default: true]
  recibir_alertas_admin boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
}

// =============================================================================
// REPORTES_SCHEMA (MS-Reportes)
// =============================================================================

Table cache_reportes {
  id bigint [pk, increment]
  tipo varchar(50) [not null]
  parametros jsonb [not null]
  datos jsonb [not null]
  hash_parametros varchar(64) [unique, note: 'SHA-256']
  generado_en timestamp [not null, default: `now()`]
  expiracion timestamp [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    hash_parametros
    expiracion
  }
}

Table ejecuciones_reporte {
  id bigint [pk, increment]
  tipo_reporte varchar(50) [not null]
  parametros jsonb [not null]
  usuario_id bigint [not null, note: 'ref auth_schema.usuarios']
  fecha_ejecucion timestamp [not null, default: `now()`]
  duracion_ms integer
  estado varchar(20) [not null, note: 'EXITO/ERROR']
  archivo_url varchar(500)
  formato varchar(10) [note: 'PDF/EXCEL']
  error_mensaje text
  created_at timestamp [not null, default: `now()`]
}

// =============================================================================
// SHARED_SCHEMA (Compartido - auditoria + idempotencia)
// =============================================================================

Table audit_log {
  id bigint [pk, increment]
  microservicio varchar(50) [not null]
  recurso varchar(100) [not null]
  recurso_id varchar(50)
  accion varchar(50) [not null, note: 'CREATE/UPDATE/DELETE/READ/LOGIN/LOGOUT']
  usuario_id bigint
  usuario_email varchar(255)
  ip varchar(45)
  user_agent text
  datos_anteriores jsonb
  datos_nuevos jsonb
  fecha timestamp [not null, default: `now()`]
  correlation_id varchar(100)

  indexes {
    (microservicio, fecha)
    (usuario_id, fecha)
    (recurso, recurso_id)
  }
}

Table processed_events {
  id bigint [pk, increment]
  event_id uuid [unique, not null]
  microservicio_consumidor varchar(50) [not null]
  tipo_evento varchar(100) [not null]
  processed_at timestamp [not null, default: `now()`]

  indexes {
    (microservicio_consumidor, processed_at)
  }
}

// =============================================================================
// REFERENCIAS CROSS-SCHEMA (sin FK fisica - solo dibujo logico)
// =============================================================================

Ref: estudiantes.usuario_id > usuarios.id
Ref: estudiantes.tipo_curso_id > tipos_curso.id
Ref: estudiantes.categoria_licencia_id > categorias_licencia.id

Ref: instructores.usuario_id > usuarios.id

Ref: vehiculos.categoria_licencia_id > categorias_licencia.id

Ref: asignaciones.instructor_id > instructores.id
Ref: asignaciones.estudiante_id > estudiantes.id
Ref: asignaciones.vehiculo_id > vehiculos.id

Ref: asistencia.asignacion_id > asignaciones.id

Ref: facturas.estudiante_id > estudiantes.id
Ref: facturas.concepto_facturacion_id > conceptos_facturacion.id

Ref: pagos.usuario_registro_id > usuarios.id

Ref: notificaciones.usuario_id > usuarios.id
Ref: preferencias_notificacion.usuario_id - usuarios.id
Ref: ejecuciones_reporte.usuario_id > usuarios.id

// =============================================================================
// GRUPOS DE TABLAS POR SCHEMA (para dbdiagram.io)
// =============================================================================

TableGroup auth_schema {
  usuarios
  roles
  permisos
  usuario_rol
  rol_permiso
  password_reset_token
  refresh_tokens
  configuracion_escuela
  tipos_curso
  conceptos_facturacion
  categorias_licencia
  plantillas_email
}

TableGroup estudiantes_schema {
  estudiantes
  documentos
  contactos_emergencia
  progreso_academico
  asistencia
}

TableGroup instructores_schema {
  instructores
  certificaciones
  disponibilidad
  horarios_trabajo
}

TableGroup vehiculos_schema {
  vehiculos
  tipos_combustible
  mantenimientos
  registros_combustible
  inspecciones
  documentos_vehiculo
}

TableGroup asignaciones_schema {
  asignaciones
  cambios_asignacion
  historial_estados
}

TableGroup cobros_schema {
  facturas
  factura_cuotas
  pagos
  reconciliacion
}

TableGroup notificaciones_schema {
  notificaciones
  log_envios_email
  preferencias_notificacion
}

TableGroup reportes_schema {
  cache_reportes
  ejecuciones_reporte
}

TableGroup shared_schema {
  audit_log
  processed_events
}
