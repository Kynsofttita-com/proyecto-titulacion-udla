<?xml version="1.0" encoding="UTF-8"?>
<!--
    common-security
    ===============
    Librería compartida con utilidades de seguridad: JwtTokenProvider,
    JwtAuthenticationFilter, configuraciones base de Spring Security.
    Usada por API Gateway y todos los microservicios para validar JWT.

    Las dependencias completas (Spring Security, JWT) se agregan en Sprint 4.
    En Sprint 1 solo establecemos la estructura base.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.escuela</groupId>
        <artifactId>escuela-backend-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-security</artifactId>
    <packaging>jar</packaging>

    <name>Common Security</name>
    <description>Utilidades compartidas de seguridad (JWT, Spring Security)</description>

    <dependencies>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- SLF4J para logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!--
            Las dependencias de Spring Security, JWT y validación se agregan
            en Sprint 4 (Tarea de implementación de JWT). En Sprint 1 solo
            establecemos la estructura del módulo.
        -->
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
    </build>
</project>
