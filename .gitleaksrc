[general]
title = "Gitleaks configuration for Proyecto Titulación"
description = "Secret scanning configuration"
exit-code = 1
verbose = true
redact = true

[[rules]]
description = "AWS Access Key"
id = "aws-access-key-id"
regex = '''(A3T[A-Z0-9]|AKIA|AIDA|AIPAI)[A-Z0-9]{16}'''
tags = ["aws", "key"]
keywords = ["AKIA"]

[[rules]]
description = "AWS Secret Access Key"
id = "aws-secret-access-key"
regex = '''aws(.{0,20})?['\"][0-9a-zA-Z/+]{40}['\"]'''
tags = ["aws", "secret"]

[[rules]]
description = "Slack Token"
id = "slack-token"
regex = '''xox[baprs]-([0-9]{10,13})-([0-9]{10,13})-[A-Za-z0-9]{24,34}'''
tags = ["slack", "token"]

[[rules]]
description = "Private Key"
id = "private-key"
regex = '''-----BEGIN (RSA|DSA|EC|PGP) PRIVATE KEY-----'''
tags = ["private", "key"]

[[rules]]
description = "GitHub Token"
id = "github-token"
regex = '''ghp_[0-9a-zA-Z]{36}|ghu_[0-9a-zA-Z]{36}|ghs_[0-9a-zA-Z]{36}|ghr_[0-9a-zA-Z]{36}'''
tags = ["github", "token"]

[[rules]]
description = "Database URL"
id = "database-url"
regex = '''(mongodb|mysql|postgres)://[^\s:]+:[^\s@]+@[^\s/]+/[^\s]*'''
tags = ["database", "url"]

[allowlist]
paths = [
    "go.sum",
    "yarn.lock",
    "package.lock",
    ".env.example",
    ".env.template"
]

commits = []

branches = []
