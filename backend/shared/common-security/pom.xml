<?xml version="1.0" encoding="UTF-8"?>
<!--
    common-security
    ===============
    Libreria compartida con utilidades de seguridad JWT.

    Provee:
      - JwtTokenProvider para generar y validar tokens HS512.
      - UserContext / UserContextHolder para que microservicios downstream
        accedan al usuario autenticado leyendo headers X-User-*.
      - AutoConfiguration que registra el JwtTokenProvider via JwtProperties.

    Decisiones de diseno (Sprint 4 / DECISIONES.md):
      - Algoritmo: HS512 (HMAC simetrico) con clave de 512 bits.
      - Tipos de token: ACCESS (15 min) y REFRESH (7 dias).
      - Refresh con rotation: cada uso del refresh genera otro nuevo
        (la persistencia de jtis usados va en MS-Auth, T4.2).
      - Validacion centralizada en API Gateway (T4.3).
        Los MS leen headers X-User-* (no validan token).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.escuela</groupId>
        <artifactId>escuela-backend-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-security</artifactId>
    <packaging>jar</packaging>

    <name>Common Security</name>
    <description>Utilidades compartidas de seguridad (JWT)</description>

    <dependencies>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- SLF4J para logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Spring Boot core (para @ConfigurationProperties + @AutoConfiguration) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- JJWT (JSON Web Tokens) - 0.12.x usa la nueva API Jwts.builder() -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
    </build>
</project>
