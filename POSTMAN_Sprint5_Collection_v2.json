            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"{{nombreCompleto}} (Actualizado)\",\n  \"numeroTelefono\": \"+593987654321\",\n  \"domicilio\": \"Quito, Ecuador (Actualizado)\",\n  \"provincia\": \"Pichincha\",\n  \"ciudad\": \"Quito\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/estudiantes/{{estudianteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["estudiantes", "{{estudianteId}}"]
            },
            "description": "Actualiza un estudiante existente por ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK o 404 Not Found', () => {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Nombre fue actualizado', () => {",
                  "    pm.expect(json.nombreCompleto).to.include('Actualizado');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /estudiantes/{id} (Eliminar - Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estudiantes/{{estudianteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["estudiantes", "{{estudianteId}}"]
            },
            "description": "Realiza soft-delete de un estudiante (marca como eliminado, no lo borra de BD)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 No Content o 404 Not Found', () => {",
                  "  pm.expect([204, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 204) {",
                  "  console.log('✅ Estudiante eliminado (soft-delete)');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
