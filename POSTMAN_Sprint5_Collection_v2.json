    {
      "name": "4 ERROR HANDLING",
      "item": [
        {
          "name": "Cédula duplicada (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cedula\": \"{{cedula}}\",\n  \"email\": \"otro@escuela.local\",\n  \"nombreCompleto\": \"Otro Estudiante\",\n  \"numeroTelefono\": \"{{numeroTelefono}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/estudiantes",
              "host": ["{{baseUrl}}"],
              "path": ["estudiantes"]
            },
            "description": "Intenta crear estudiante con cédula duplicada. Debe retornar 409 Conflict con RFC 7807 ProblemDetail."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
                  "const json = pm.response.json();",
                  "pm.test('Response tiene type (RFC 7807)', () => pm.expect(json.type).to.exist);",
                  "pm.test('Response tiene title', () => pm.expect(json.title).to.exist);",
                  "pm.test('Response tiene detail', () => pm.expect(json.detail).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Email duplicado (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cedula\": \"1111111111\",\n  \"email\": \"{{email}}\",\n  \"nombreCompleto\": \"Otro Estudiante\",\n  \"numeroTelefono\": \"{{numeroTelefono}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/estudiantes",
              "host": ["{{baseUrl}}"],
              "path": ["estudiantes"]
            },
            "description": "Intenta crear estudiante con email duplicado. Debe retornar 409 Conflict."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
                  "const json = pm.response.json();",
                  "pm.test('ProblemDetail contiene información de error', () => {",
                  "  pm.expect(json.title).to.include('Email');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Sin autenticación (401 Unauthorized)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/estudiantes",
              "host": ["{{baseUrl}}"],
              "path": ["estudiantes"]
            },
            "description": "Intenta acceder endpoint sin JWT token. Debe retornar 401 Unauthorized."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "No encontrado (404 Not Found)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estudiantes/99999",
              "host": ["{{baseUrl}}"],
              "path": ["estudiantes", "99999"]
            },
            "description": "Intenta obtener estudiante con ID que no existe. Debe retornar 404 Not Found."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));",
                  "const json = pm.response.json();",
                  "pm.test('ProblemDetail contiene información de error', () => {",
                  "  pm.expect(json.title).to.include('no encontrado');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Licencia duplicada en Instructor (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cedula\": \"2222222222\",\n  \"email\": \"otro-instructor@escuela.local\",\n  \"licencia\": \"{{licencia}}\",\n  \"nombreCompleto\": \"Otro Instructor\",\n  \"numeroTelefono\": \"{{numeroTelefono}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/instructores",
              "host": ["{{baseUrl}}"],
              "path": ["instructores"]
            },
            "description": "Intenta crear instructor con licencia duplicada. Debe retornar 409 Conflict."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
                  "const json = pm.response.json();",
                  "pm.test('Error menciona licencia', () => {",
                  "  pm.expect(json.title || json.detail).to.include('Licencia');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
