################################################################################
# PLANTILLA .env — Referencia de variables
################################################################################
#
# ⚠️ IMPORTANTE: Este archivo es SOLO una referencia.
# NO uses este archivo directamente.
#
# Cómo funciona:
# 1. Hernán te pasa un archivo .env REAL (con valores)
# 2. Tú copias ese .env a la raíz del proyecto (mismo lugar que CLAUDE.md)
# 3. Docker Compose lee automáticamente el .env
# 4. Variables se cargan en cada contenedor
#
# Este archivo (.env.template) solo muestra QUÉ variables existen.
# Usa esto como REFERENCIA cuando Hernán te dé el .env real.
#
################################################################################

################################################################################
# POSTGRESQL — Base de datos principal
################################################################################

# Usuario de PostgreSQL
POSTGRES_USER=escuela_user

# Contraseña de PostgreSQL (CRÍTICO — debe ser fuerte)
# Ejemplo: MyStr0ng!Pass123#Secure
POSTGRES_PASSWORD=<CAMBIAR-A-CONTRASEÑA-REAL>

# Nombre de la base de datos
POSTGRES_DB=escuela_db

# Argumentos adicionales para PostgreSQL (para estadísticas, etc.)
# Normalmente no necesita cambiar, pero si incluye migraciones especiales:
POSTGRES_INITDB_ARGS=-c shared_preload_libraries=pg_stat_statements

################################################################################
# JWT — Seguridad (tokens para autenticación)
################################################################################

# Clave secreta para firmar tokens JWT (HS512)
# Debe ser: 512 bits, en formato base64
# Generador online: https://www.base64encode.org/ (512 bits = 68 caracteres base64)
# Ejemplo: KynsoftTitaSeguroJWT2026Base64EncodedPara512BitsHS512AlgoritmoFirma
JWT_SECRET=<CAMBIAR-A-CLAVE-512-BITS-BASE64>

################################################################################
# MAILTRAP — Pruebas de email (desarrollo)
################################################################################

# En desarrollo, usamos Mailtrap para ver emails sin enviar realmente
# En producción, usamos Gmail SMTP

# Credenciales de Mailtrap (obtener de https://mailtrap.io)
MAILTRAP_USER=<usuario-mailtrap>
MAILTRAP_PASSWORD=<contraseña-mailtrap>

# En producción (luego, no para Sprint 12):
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=587
# GMAIL_SMTP_USER=tu-email@gmail.com
# GMAIL_SMTP_PASSWORD=app-password-de-gmail

################################################################################
# MINIO — Almacenamiento S3 compatible
################################################################################

# Usuario administrador de MinIO
MINIO_ROOT_USER=minioadmin

# Contraseña del administrador de MinIO
MINIO_ROOT_PASSWORD=minioadmin123

# (Endpoint y bucket se configuran en application.yml de cada MS)

################################################################################
# RABBITMQ — Mensajería (por defecto guest/guest)
################################################################################

# En Docker Compose, RabbitMQ ya viene con usuario guest:guest
# Si quieres cambiar (no recomendado para dev):
# RABBITMQ_USER=miusuario
# RABBITMQ_PASSWORD=micontraseña

################################################################################
# TIMEZONE — Zona horaria (CRÍTICO)
################################################################################

# SIEMPRE debe ser America/Guayaquil
# Esto asegura que LocalTime y LocalDate en Java usen la zona correcta
# Si cambias esto, los timestamps en BD estarán desfasados (+5 horas)
TZ=America/Guayaquil

################################################################################
# LOGGING — Nivel de log (opcional)
################################################################################

# Por defecto: INFO
# Valores: DEBUG, INFO, WARN, ERROR
# Para desarrollo verbose:
# LOG_LEVEL=DEBUG
# Para producción:
# LOG_LEVEL=WARN

################################################################################
# ACTUATOR — Health checks (opcional)
################################################################################

# Exponer endpoints de actuador para health checks
# Normalmente en application.yml, pero puede heredar:
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

################################################################################
# SECURITY — Spring Security (en application.yml, pero referencia aquí)
################################################################################

# Account lockout: después de N intentos fallidos
SECURITY_MAX_LOGIN_ATTEMPTS=3
SECURITY_LOCKOUT_MINUTES=15

# JWT token expiration (en application.yml):
JWT_EXPIRATION_HOURS=24

################################################################################
# ORACLE CLOUD — Producción (NO para Sprint 12)
################################################################################

# Estas variables son SOLO para cuando deploys a producción
# ORACLE_CLOUD_TENANCY=tu-tenancy-id
# ORACLE_CLOUD_USER=tu-user-id
# ORACLE_CLOUD_FINGERPRINT=tu-fingerprint
# ORACLE_CLOUD_PRIVATE_KEY_PATH=/path/to/key
# ORACLE_CLOUD_REGION=us-phoenix-1

################################################################################
# RESUMEN — QUÉ NECESITÁS
################################################################################

# Hernán te pasará un .env con estos valores reales:
#
# ✓ POSTGRES_PASSWORD — Contraseña real (fuerte)
# ✓ JWT_SECRET — Clave de 512 bits
# ✓ MAILTRAP_USER — Usuario de Mailtrap
# ✓ MAILTRAP_PASSWORD — Contraseña de Mailtrap
# ✓ MINIO_ROOT_PASSWORD — Contraseña de MinIO
# ✓ TZ — America/Guayaquil (CRÍTICO)
#
# Resto de variables tienen valores por defecto que funcionan.
#

################################################################################
# CÓMO USAR ESTE ARCHIVO
################################################################################

# 1. Hernán te pasa un archivo .env (real, con valores)
# 2. Tú lo copias a la raíz del proyecto:
#    cp <ruta-donde-lo-guardaste>/.env ~/proyecto-titulacion-udla/.env
# 3. NO uses este .env.template (es solo referencia)
# 4. Docker Compose lee automáticamente el .env y carga variables
# 5. Listo.

################################################################################
# VALIDACIÓN
################################################################################

# Para verificar que tu .env es válido:
#
# grep -E "^[A-Z_]+=.+" .env | wc -l
# # Debe retornar: ≥ 8 variables (mínimo para funcionar)
#
# grep "CAMBIAR" .env
# # Debe estar vacío (sin placeholders <CAMBIAR>)
#
# grep "POSTGRES_PASSWORD=" .env
# # Debe mostrar tu contraseña real (sin <...>)

################################################################################
# ¡LISTO!
################################################################################

# Quando Hernán te dé el .env real, simplemente cópialo y olvídate de esto.
# Docker Compose hace el resto automáticamente.
