  "item": [
    {
      "name": "1 AUTENTICACIÓN",
      "item": [
        {
          "name": "Login (obtener JWT token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Obtiene accessToken y refreshToken. Los tokens se guardan automáticamente en variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Response tiene accessToken', () => pm.expect(json.accessToken).to.be.a('string').and.not.empty);",
                  "pm.test('Response tiene refreshToken', () => pm.expect(json.refreshToken).to.be.a('string').and.not.empty);",
                  "pm.test('Response tiene user con email', () => pm.expect(json.user.email).to.exist);",
                  "pm.test('User tiene roles array', () => pm.expect(json.user.roles).to.be.an('array'));",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "console.log('✅ Tokens guardados. AccessToken:', json.accessToken.substring(0, 20) + '...');"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar token (GET /auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Verifica que el token JWT es válido obteniendo datos del usuario autenticado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Email coincide con adminEmail', () => pm.expect(json.email).to.eql(pm.collectionVariables.get('adminEmail')));",
                  "pm.test('Roles es array', () => pm.expect(json.roles).to.be.an('array'));",
                  "pm.test('Roles incluye ADMIN', () => pm.expect(json.roles).to.include('ADMIN'));"
                ]
              }
            }
          ]
        }
      ]
    },
