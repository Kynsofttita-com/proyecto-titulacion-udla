{
  "info": {
    "name": "Sprint 3 + 4 — Auth & Notificaciones",
    "_postman_id": "a1b2c3d4-1234-5678-9abc-def012345678",
    "description": "Colección de pruebas para validar Sprint 3 (MS-Auth: login, refresh, logout, me, forgot/reset password) y Sprint 4 (eventos a MS-Notificaciones via RabbitMQ → Mailtrap).\n\nRequisitos:\n- Docker compose levantado (14 servicios healthy)\n- Mailtrap configurado en .env (JAVA_MAIL_ENABLED=true)\n- Admin seed: admin@escuela.local / Admin123!\n\nFlujo recomendado: correr la carpeta '1 Happy Path' primero (login guarda tokens en variables). Luego correr el resto en cualquier orden.\n\nRunner: Collection Runner → seleccionar carpetas → Run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "adminEmail", "value": "admin@escuela.local", "type": "string" },
    { "key": "adminPassword", "value": "Admin123!", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "resetToken", "value": "", "type": "string", "description": "Token UUID que llega al email de Mailtrap; pégalo manualmente" }
  ],
  "item": [
    {
      "name": "1 Happy Path",
      "item": [
        {
          "name": "Login Admin (200)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Tiene accessToken', () => pm.expect(json.accessToken).to.be.a('string').and.not.empty);",
                  "pm.test('Tiene refreshToken', () => pm.expect(json.refreshToken).to.be.a('string').and.not.empty);",
                  "pm.test('user.email === admin', () => pm.expect(json.user.email).to.eql(pm.collectionVariables.get('adminEmail')));",
                  "pm.test('roles incluye ADMIN', () => pm.expect(json.user.roles).to.include('ADMIN'));",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me (200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('email coincide', () => pm.expect(json.email).to.eql(pm.collectionVariables.get('adminEmail')));",
                  "pm.test('roles es array', () => pm.expect(json.roles).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/refresh (200)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Nuevo accessToken', () => pm.expect(json.accessToken).to.be.a('string').and.not.empty);",
                  "pm.test('Nuevo refreshToken (rotado)', () => pm.expect(json.refreshToken).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/logout (204)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 (No Content)', () => pm.response.to.have.status(204));",
                  "pm.test('Body vacio', () => pm.expect(pm.response.text()).to.be.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
